# Nument Leads web app. Copy to .env.local for local work; set the same keys in Render.
# Never commit real values.

# dev or prod. "dev" shows a DEV badge in the top bar.
APP_ENV=dev

# Supabase project (Project Settings > API). Public, protected by Row Level Security.
# NEXT_PUBLIC_* values are baked in at build time: set them in Render before the build.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this app, used in password reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only. The service role key bypasses Row Level Security: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Engine runs from the Engine page (GitHub Actions workflow_dispatch). Fine-grained token,
# "Actions: read and write" on this repository only.
GH_REPO=with-nument/nument-lead
GH_DISPATCH_REF=main
GH_DISPATCH_TOKEN=

# Only for `pnpm db:types` (regenerate src/lib/database.types.ts) and the e2e tests.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
