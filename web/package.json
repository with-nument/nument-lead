{
  "name": "nument-leads-web",
  "version": "0.1.0",
  "private": true,
  "description": "Nument Leads web app: the team workspace for daily, evidence-backed leads.",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:types": "node scripts/gen-db-types.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
