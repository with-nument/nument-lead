# ===== nument-leads: every environment variable (names only, never values) =====
# Copy to engine/.env.dev, engine/.env.prod and web/.env.local, fill in only what each one needs
# (table 0.10 of IMPLEMENTATION_PLAN.md), then: chmod 600 engine/.env.* web/.env.local

# dev | prod. The engine refuses to touch the live sheets when this is dev.
APP_ENV=dev

# ---- Supabase ----
# Session pooler URI (IPv4, port 5432). Never the direct connection, never port 6543.
DATABASE_URL=
SUPABASE_URL=
# Bypasses RLS. Engine and web server only. Never in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe values for the web app (protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the web app (password reset links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- AI ----
GEMINI_API_KEY=
# Second Gemini key, used when the first one hits its quota
GEMINI_API_KEY_BACKUP=
# OpenAI stays off until settings.providers_enabled.openai is switched on
OPENAI_API_KEY=

# ---- Google ----
# Restricted to Places API (New) and PageSpeed Insights API
GOOGLE_MAPS_API_KEY=
# CI: the full JSON text of the service account key. Locally: leave empty and use the file path.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=~/.config/lead-engine/service-account.json

# ---- Sheets ----
# Live sheets: prod only. Leave empty in dev.
SHEET_MASTER_ID=
SHEET_CALLER_ID=
SHEET_STAGING_ID=

# ---- Behaviour ----
ASSOCIATE_NAME=Aditya
USER_AGENT=NumentLeadBot/1.0 (+https://nument.in)

# ---- Web app only ----
# The engine's GitHub workflows, started from the Engine page
GH_REPO=with-nument/nument-lead
GH_DISPATCH_REF=main
# Fine-grained token: Actions read and write on this repository only
GH_DISPATCH_TOKEN=

# ---- CI only ----
BACKUP_PASSPHRASE=
ALERT_EMAIL=
# Optional: weekly report and alerts by email (Resend). The sender must be one Resend accepts.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
